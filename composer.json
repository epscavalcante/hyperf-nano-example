{
  "name": "epscavalcante/hyperf-nano-example",
  "description": "HyperF Nano example",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Eduardo Cavalcante",
      "email": "eduardo.ps.cavalcante@gmail.com"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Src\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require": {
    "hyperf/nano": "^2.0.1",
    "hyperf/devtool": "^3.2@alpha",
    "hyperf/db-connection": "^3.2@alpha"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "test": "php vendor/bin/pest",
    "serve": "php hyperf.php start",
    "analise": "php vendor/bin/phpstan analyse src --level=max"
  },
  "require-dev": {
    "friendsofhyperf/pest-plugin-hyperf": "3.2.x-dev",
    "hyperf/testing": "^3.2@alpha",
    "phpstan/phpstan": "^2.1"
  }
}
